    print(
        f"""colibri {__version__} — Qwen3.6 / Qwen3-Coder Inference Engine for Apple Silicon (Metal)

Usage:
  coli serve <model_dir> [options]    Start the OpenAI-compatible HTTP server (default :8000)
  coli chat  [model_dir] [options]    Interactive terminal chat with Jimmy bot (Qwen3.6)
  coli run   [model_dir] -p <prompt>  Run a single prompt and print the response
  coli info  [model_dir]              Show Apple Silicon unified memory & Qwen3.6 sizing
  coli build                          Compile native `qwen36` + `convert_qwen36` binaries
  coli import <hf_dir> [options]      Convert HuggingFace Qwen3.6 weights (`convert_qwen36`)
  coli stop                           Stop a running background Colibri server
  coli version                        Print version ({__version__})
  coli help                           Show this help message

Key Options for `coli serve` / `coli chat`:
  --model-dir <dir>    Path to Qwen3.6 / Qwen3-Coder model directory
  --engine <path>      Path to compiled `qwen36` binary (default: c/qwen36)
  --host <addr>        Bind address (default: 127.0.0.1)
  --port <port>        HTTP port (default: 8000)
  --ctx <tokens>       Context window length (env `{CONTEXT_ENV}`, default: {DEFAULT_CONTEXT}, max: {MAX_CONTEXT})
  --cap <tokens>       Max output tokens per turn (default: {DEFAULT_MAX_OUTPUT}, chat: {INTERACTIVE_MAX_OUTPUT})
  --model-id <id>      Served OpenAI model identifier (default: {DEFAULT_MODEL_ID})
"""
    )
    return 0


def cmd_info(argv: list[str]) -> int:
    model_dir = argv[0] if argv and not argv[0].startswith("-") else _find_default_model_dir()
    mem_bytes = _sysctl_int("hw.memsize", 16 * 1024**3)
    mem_gb = mem_bytes / (1024.0**3)
    pcores = team_cpu_count()
    engine_bin = default_engine(QWEN36_FAMILY)
    print(f"Colibri v{__version__} (Apple Silicon Unified Memory — {QWEN36_FAMILY.display_name})")
    print(f"  Architecture      : {ARCH_ID} (Metal GPU + Accelerate AMX)")
    print(f"  Unified Memory    : {mem_gb:.1f} GB")
    print(f"  Performance Cores : {pcores} (OMP_NUM_THREADS={pcores})")
    print(f"  Engine Binary     : {engine_bin} ({'present' if Path(engine_bin).is_file() else 'not built yet'})")
    print(f"  Context Env       : {CONTEXT_ENV} (default {DEFAULT_CONTEXT}, max {MAX_CONTEXT}, auto {chat_context_env({})})")
    print(f"  KV Cache Slots    : {MAX_KV_SLOTS}")
    if model_dir:
        try:
            resolved = resolve_model(model_dir)
            disp_name, disp_sub = display_for(resolved)
            print(f"  Model Directory   : {resolved.model_dir}")
            print(f"  Model Profile     : {disp_name} ({disp_sub}), id={default_model_id(resolved)}")
        except Exception as exc:
            print(f"  Model Directory   : {model_dir} ({exc})")
    return 0


def cmd_build(argv: list[str]) -> int:
    targets = argv if argv else ["qwen36", "convert_qwen36"]
    cmd = ["make", "-C", str(HERE), f"-j{team_cpu_count()}", *targets]
    print("+", " ".join(cmd), flush=True)
    return subprocess.call(cmd)


def cmd_import(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="coli import", description="Convert HuggingFace Qwen3.6 weights")
    parser.add_argument("model_dir", help="Path to HuggingFace Qwen3.6 / Qwen3-Coder checkpoint directory")
    parser.add_argument("--ebits", type=int, default=4, help="Routed expert quantization bits (2, 3, or 4; default 4)")
    args = parser.parse_args(argv)

    converter_bin = HERE / "convert_qwen36"
    if not converter_bin.is_file():
        rc = cmd_build(["convert_qwen36"])
        if rc != 0:
            return rc
    cmd = [str(converter_bin), str(Path(args.model_dir).expanduser().resolve()), "--ebits", str(args.ebits)]
    print("+", " ".join(cmd), flush=True)
    return subprocess.call(cmd)


def cmd_stop(_argv: list[str]) -> int:
    stopped = False
    if PID_FILE.is_file():
        try:
            pid = int(PID_FILE.read_text(encoding="utf-8").strip())
            os.kill(pid, signal.SIGTERM)
            stopped = True
            print(f"Stopped colibri server (PID {pid}).")
        except ProcessLookupError:
            pass
        except Exception as exc:
            print(f"Warning: could not stop PID from {PID_FILE}: {exc}", file=sys.stderr)
        try:
            PID_FILE.unlink()
        except OSError:
            pass
    if not stopped:
        print("No active colibri server PID file found.")
    return 0


def cmd_serve(argv: list[str]) -> int:
    """Delegate directly to `c/openai_server.py` with Qwen3.6 defaults."""
    forwarded = list(argv)
    has_model_dir = any(a == "--model-dir" or a.startswith("--model-dir=") for a in forwarded)
    if not has_model_dir:
        positional = [a for a in forwarded if not a.startswith("-")]
        if positional and Path(positional[0]).expanduser().is_dir():
            m_dir = positional[0]
            forwarded.remove(m_dir)
            forwarded = ["--model-dir", m_dir, *forwarded]
        else:
            auto_dir = _find_default_model_dir()
            if auto_dir:
                forwarded = ["--model-dir", auto_dir, *forwarded]

    server_script = str(HERE / "openai_server.py")
    PID_FILE.parent.mkdir(parents=True, exist_ok=True)
    PID_FILE.write_text(str(os.getpid()), encoding="utf-8")
    try:
        return subprocess.call([sys.executable, server_script, *forwarded])
    finally:
        try:
            if PID_FILE.is_file() and PID_FILE.read_text(encoding="utf-8").strip() == str(os.getpid()):
                PID_FILE.unlink()
        except OSError:
            pass


def _stream_chat_turn(
    base_url: str,
    model_id: str,
    messages: list[dict],
    max_tokens: int,
    temperature: float = 0.6,
    cache_slot: int = 0,
) -> tuple[str, str]:
    url = f"{base_url.rstrip('/')}/v1/chat/completions"
    payload = {
        "model": model_id,
        "messages": messages,
        "max_tokens": max_tokens,
        "temperature": temperature,
        "stream": True,
        "cache_slot": cache_slot,
        "preserve_thinking": True,
        "context_compaction": "auto",
    }
    req = urllib.request.Request(
        url,
        data=json.dumps(payload, ensure_ascii=False).encode("utf-8"),
        headers={"Content-Type": "application/json", "Accept": "text/event-stream"},
        method="POST",
    )
    content_parts: list[str] = []
    reasoning_parts: list[str] = []
    with urllib.request.urlopen(req, timeout=300) as resp:
        for raw_line in resp:
            line = raw_line.decode("utf-8", errors="replace").strip()
            if not line.startswith("data:"):
                continue
            data_str = line[5:].strip()
            if not data_str or data_str == "[DONE]":
                continue
            try:
                chunk = json.loads(data_str)
            except Exception:
                continue
            choices = chunk.get("choices") or []
            if not choices:
                continue
            delta = choices[0].get("delta") or {}
            r_tok = delta.get("reasoning_content")
            if r_tok:
                reasoning_parts.append(str(r_tok))
            c_tok = delta.get("content")
            if c_tok:
                s_tok = str(c_tok)
                content_parts.append(s_tok)
                print(s_tok, end="", flush=True)
    print(flush=True)
    return "".join(content_parts), "".join(reasoning_parts)


def cmd_chat_or_run(argv: list[str], interactive: bool = True) -> int:
    parser = argparse.ArgumentParser(
        prog="coli chat" if interactive else "coli run",
        description="Interactive chat or single-shot prompt with Qwen3.6 (Jimmy bot)",
    )
    parser.add_argument("model_dir", nargs="?", default=None, help="Optional model directory")
    parser.add_argument("--model-dir", dest="flag_model_dir", default=None, help="Model directory")
    parser.add_argument("--host", default=DEFAULT_HOST)
    parser.add_argument("--port", type=int, default=DEFAULT_PORT)
    parser.add_argument("-p", "--prompt", default=None, help="Single-shot prompt text")
    parser.add_argument("--system", default=DEFAULT_SYSTEM_PROMPT, help="System prompt")
    parser.add_argument("--cap", "--max-tokens", dest="max_tokens", type=int, default=cap_for_arch(ARCH_ID, interactive=interactive))
    parser.add_argument("--temperature", type=float, default=0.6)
    args = parser.parse_args(argv)

    base_url = f"http://{args.host}:{args.port}"
    health = _server_health(base_url)
    proc = None
    try:
        if health is None:
            model_dir = args.flag_model_dir or args.model_dir or _find_default_model_dir()
            if not model_dir:
                print(
                    f"No running server at {base_url} and no model directory specified.\n"
                    f"Start one with: coli serve /path/to/qwen36-model",
                    file=sys.stderr,
                )
                return 1
            env = dict(os.environ)
            chat_context_env(env)
            proc = subprocess.Popen(
                [
                    sys.executable,
                    str(HERE / "openai_server.py"),
                    "--model-dir",
                    str(model_dir),
                    "--host",
                    args.host,
                    "--port",
                    str(args.port),
                ],
                env=env,
            )
            for _ in range(180):
                time.sleep(0.5)
                health = _server_health(base_url)
                if health and health.get("status") == "ok":
                    break
            else:
                print("Timed out waiting for Qwen3.6 engine to become ready.", file=sys.stderr)
                return 1

        model_id = (health or {}).get("model") or DEFAULT_MODEL_ID
        messages: list[dict] = [{"role": "system", "content": args.system}]

        if args.prompt or not interactive:
            user_prompt = args.prompt or " ".join(sys.stdin.read().splitlines()).strip()
            if not user_prompt:
                print("Error: non-empty prompt required for `coli run`.", file=sys.stderr)
                return 1
            messages.append({"role": "user", "content": user_prompt})
            _stream_chat_turn(base_url, model_id, messages, args.max_tokens, args.temperature)
            return 0

        print(f"Connected to {model_id} at {base_url} (Jimmy bot). Type /exit or Ctrl-D to quit.")
        while True:
            try:
                user_text = input("\nYou> ").strip()
            except (EOFError, KeyboardInterrupt):
                print()
                break
            if not user_text:
                continue
            if user_text.lower() in ("/exit", "/quit", "exit", "quit"):
                break
            if user_text.lower() == "/clear":
                messages = [{"role": "system", "content": args.system}]
                print("Conversation cleared.")
                continue
            messages.append({"role": "user", "content": user_text})
            print("Jimmy bot> ", end="", flush=True)
            reply, reasoning = _stream_chat_turn(
                base_url, model_id, messages, args.max_tokens, args.temperature
            )
            asst_msg: dict = {"role": "assistant", "content": reply}
            if reasoning:
                asst_msg["reasoning_content"] = reasoning
            messages.append(asst_msg)
        return 0
    finally:
        if proc is not None:
            proc.terminate()
            try:
                proc.wait(timeout=5)
            except Exception:
                proc.kill()


def main(argv: list[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    if not args or args[0] in ("help", "--help", "-h"):
        return _print_help()
    cmd = args[0]
    rest = args[1:]

    if cmd in ("version", "--version", "-v", "-V"):
        print(f"coli {__version__} ({ARCH_ID})")
        return 0
    if cmd in ("serve", "start", "up"):
        return cmd_serve(rest)
    if cmd == "chat":
        return cmd_chat_or_run(rest, interactive=True)
    if cmd == "run":
        return cmd_chat_or_run(rest, interactive=False)
    if cmd in ("info", "status", "ps", "models"):
        return cmd_info(rest)
    if cmd == "build":
        return cmd_build(rest)
    if cmd in ("import", "convert"):
        return cmd_import(rest)
    if cmd in ("stop", "down"):
        return cmd_stop(rest)

    # If first argument is a directory, treat as `coli serve <model_dir> ...`
    if Path(cmd).expanduser().is_dir():
        return cmd_serve(args)

    print(f"Unknown command: {cmd!r}. Run `coli --help` for usage.", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
