#!/usr/bin/env python3
"""Colibri (`coli`) CLI for Qwen3.6 / Qwen3-Coder on Apple Silicon (Metal + Unified Memory).

Provides:
- `coli serve`   : Start the OpenAI-compatible HTTP gateway (`c/openai_server.py`) for Qwen3.6.
- `coli chat`    : Interactive terminal chat with Jimmy bot (Qwen3.6-35B-A3B).
- `coli run`     : Run a single prompt against a running Colibri server or local model.
- `coli info`    : Display Apple Silicon unified memory, P-core count, and Qwen3.6 configuration.
- `coli build`   : Build the native `qwen36` and `convert_qwen36` binaries via `make -C c`.
- `coli import`  : Convert a HuggingFace Qwen3.6 / Qwen3-Coder checkpoint into Colibri's format.
- `coli stop`    : Stop a background Colibri gateway server.
- `coli version` : Print version string.
- `coli help`    : Print CLI usage and options.
"""
from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import signal
import subprocess
import sys
import time
import urllib.error
import urllib.request

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))

from openai_server import (  # noqa: E402
    ARCH_ID,
    CONTEXT_ENV,
    DEFAULT_CONTEXT,
    DEFAULT_MAX_OUTPUT,
    DEFAULT_MODEL_ID,
    DEFAULT_SYSTEM_PROMPT,
    ENGINE_ARTIFACT,
    INTERACTIVE_MAX_OUTPUT,
    MAX_CONTEXT,
    MAX_KV_SLOTS,
    QWEN36_FAMILY,
    __version__,
    _sysctl_int,
    cap_for_arch,
    chat_context_env,
    default_engine,
    default_model_id,
    display_for,
    resolve_model,
    team_cpu_count,
)

DEFAULT_HOST = os.environ.get("COLIBRI_HOST", "127.0.0.1")
DEFAULT_PORT = int(os.environ.get("COLIBRI_PORT", "8000"))
PID_FILE = Path(os.path.expanduser("~/.cache/colibri/server.pid"))


def _find_default_model_dir() -> str | None:
    """Locate a Qwen3.6 / Qwen3-Coder model directory from env or standard search paths."""
    env_dir = os.environ.get("COLIBRI_MODEL_DIR") or os.environ.get("MODEL_DIR")
    if env_dir and Path(env_dir).expanduser().is_dir():
        return str(Path(env_dir).expanduser().resolve())

    candidates = [
        HERE.parent / "models" / "qwen36-35b",
        HERE.parent / "models" / "Qwen3.6-35B-A3B",
        HERE.parent / "models" / "qwen3-coder-30b",
        Path.home() / ".cache" / "colibri" / "models" / "qwen36-35b",
        Path.home() / ".cache" / "colibri" / "models" / "Qwen3.6-35B-A3B",
    ]
    models_root = Path.home() / ".cache" / "colibri" / "models"
    if models_root.is_dir():
        for child in sorted(models_root.iterdir()):
            if (child / "config.json").is_file():
                candidates.append(child)

    for cand in candidates:
        if (cand / "config.json").is_file():
            return str(cand.resolve())
    return None


def _server_health(base_url: str, timeout: float = 1.5) -> dict | None:
    url = f"{base_url.rstrip('/')}/health"
    try:
        with urllib.request.urlopen(url, timeout=timeout) as resp:
            return json.loads(resp.read().decode("utf-8", errors="replace"))
    except Exception:
        return None


